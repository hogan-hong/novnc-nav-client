{
  "name": "novnc-nav-client",
  "version": "1.0.0",
  "description": "NoVNC导航控制台本地客户端 - 解决浏览器缓存堆积内存爆满问题",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron . --debug",
    "build:win": "electron-builder --win --publish never --config.compression=store"
  },
  "build": {
    "appId": "com.hogan.novncnav",
    "productName": "NoVNC导航控制台",
    "asar": true,
    "files": [
      "**/*",
      "!*.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": ["dir"],
      "icon": "web/static/favicon.ico"
    }
  },
  "keywords": ["novnc", "vnc", "iphone", "electron"],
  "author": "Hogan Hong",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
